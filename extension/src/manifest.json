{
  "manifest_version": 3,
  "name": "Toxic Comment Filter for YouTube",
  "short_name": "Toxic Filter",
  "version": "2.0.0",
  "description": "Blur or hide toxic YouTube comments with an AI model that runs on your device. Child-safe mode included.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Toxic Comment Filter" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": []
}
